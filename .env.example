# ===== DeepSeek LLM 配置 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# ===== 微调模型配置（可选）=====
# 设置为 true 时使用本地微调模型
USE_LOCAL_MODEL=false
LOCAL_MODEL_PATH=/models/medical-triage-lora

# ===== Langfuse 可观测性 =====
# 注册 https://cloud.langfuse.com 获取免费 Key
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 数据库配置 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 服务配置 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=8501

# ===== 云端部署附加配置 (Optional) =====
# Railway 会自动注入 DATABASE_URL, 程序会自动识别并切换至 Postgres 模式
# DATABASE_URL=
